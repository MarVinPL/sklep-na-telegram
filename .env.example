# Local development only. Never commit real secrets.
POSTGRES_DB=telegram_shop
POSTGRES_USER=telegram_shop
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
API_PORT=8000

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://telegram_shop:change-me-local-only@localhost:5432/telegram_shop
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE=300

# Use the exact HTTPS host/origin serving the Mini App in non-local environments.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Sklep na Telegram
WEBAUTHN_ORIGIN=http://localhost:8000
# Comma-separated exact origins; include the Mini App frontend origin in local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
WEBAUTHN_CHALLENGE_TTL=180
AUTH_SESSION_TTL=86400
AUTH_COOKIE_NAME=shop_session
# Shared PostgreSQL-backed limit, applied per client IP and endpoint path.
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

TELEGRAM_WEBHOOK_SECRET=
