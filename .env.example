# Local development only. Never commit real secrets.
POSTGRES_DB=telegram_shop
POSTGRES_USER=telegram_shop
# Set a unique, long random password before starting Docker Compose.
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Configure only when the API and bot are implemented.
APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
